{% import '_includes/forms' as forms %}
{{ forms.textField({
   label: 'Empty State Text'|t('pricing-rules-relationship'),
   instructions: 'Shown in place of the checkboxes when the store has no pricing rules running or scheduled. Leave blank for the default message.'|t('pricing-rules-relationship'),
   id: 'defaultText',
   name: 'defaultText',
   value: field.defaultText,
}) }}
{{ forms.lightswitchField({
   label: 'Show "New Catalog Pricing Rule" Button'|t('pricing-rules-relationship'),
   instructions: 'Adds a button below the checkboxes that opens a new pricing rule in Commerce, in a new tab. Only editors allowed to create pricing rules see it.'|t('pricing-rules-relationship'),
   id: 'showNewRuleButton',
   name: 'showNewRuleButton',
   on: field.showNewRuleButton,
}) }}
{{ forms.lightswitchField({
   label: 'Show Rule Expiry Dates'|t('pricing-rules-relationship'),
   instructions: 'Shows the date each rule ends beside it. A rule that hasn\'t started yet always shows its start date.'|t('pricing-rules-relationship'),
   id: 'showRuleExpiryDates',
   name: 'showRuleExpiryDates',
   on: field.showRuleExpiryDates,
}) }}
