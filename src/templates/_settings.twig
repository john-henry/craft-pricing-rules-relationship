   id: 'showNewRuleButton',
   name: 'showNewRuleButton',
   on: field.showNewRuleButton,
}) }}
{{ forms.lightswitchField({
   label: 'Show Rule Expiry Dates'|t('pricing-rules-relationship'),
   instructions: 'Whether to display expiry dates beside pricing rules'|t('pricing-rules-relationship'),
   id: 'showRuleExpiryDates',
   name: 'showRuleExpiryDates',
   on: field.showRuleExpiryDates,
}) }}
