{
  "name": "johnhenry/craft-pricing-rules-relationship",
  "description": "A field to add relationships between Commerce Pricing Rules and an element",
  "type": "craft-plugin",
  "version": "1.0.3",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-commerce",
    "craft-plugin",
    "sales relationship",
    "catalog pricing rules",
    "promotional sales"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "John Henry",
      "homepage": "https://johnhenry.ie"
    }
  ],
  "homepage": "https://johnhenry.ie/plugins/pricing-rules-relationship/",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "craftcms/cms": "^5.0",
    "craftcms/commerce": "^5.0"
  },
  "require-dev": {
    "craftcms/phpstan": "dev-main",
    "craftcms/ecs": "dev-main"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "johnhenry\\pricingrulesrelationship\\": "src/"
    }
  },
  "scripts": {
    "phpstan": "phpstan --ansi --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "support": {
    "docs": "https://johnhenry.ie/plugins/pricing-rules-relationship/",
    "source": "https://github.com/john-henry/craft-pricing-rules-relationship",
    "issues": "https://github.com/john-henry/craft-pricing-rules-relationship/issues"
  },
  "extra": {
    "name": "Pricing Rules Relationship",
    "handle": "pricing-rules-relationship",
    "developer": "John Henry",
    "developerUrl": "https://johnhenry.ie",
    "documentationUrl": "https://johnhenry.ie/plugins/pricing-rules-relationship/",
    "changelogUrl": "https://github.com/john-henry/craft-pricing-rules-relationship/blob/craft-5/CHANGELOG.md",
    "class": "johnhenry\\pricingrulesrelationship\\PricingRulesRelationship"
  }
}
